{
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(git:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(gh pr:*)",
      "Bash(gh api:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(chmod:*)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "mcp__obsidian__read-note",
      "mcp__obsidian__create-note",
      "Bash(bash .claude/hooks/phase-guard.sh)",
      "Bash(echo \"exit: $?\")",
      "Bash(bash .claude/hooks/completion-check.sh)",
      "Bash(echo \"completion-check: $?\")"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "context7"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/phase-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/completion-check.sh"
          }
        ]
      }
    ]
  }
}
